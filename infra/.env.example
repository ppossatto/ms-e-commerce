# Copy to infra/.env (ignored by Git) and fill in.

# Postgres (superuser, used only by the init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app

# RustFS (S3 credentials)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Keycloak bootstrap admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Service database passwords (appended by ./scripts/new-service.sh)
CATALOG_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
