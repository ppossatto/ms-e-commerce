<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Inherits Spring Boot dependency management (Flyway, Testcontainers,
    Mockito, JUnit, Lombok, PostgreSQL, compiler/surefire/failsafe...).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.ppossatto.platform</groupId>
  <artifactId>build-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>build-parent</name>
  <description>Shared parent for all services: build and test setup only, no domain code.</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Security overrides of versions managed by Spring Boot 4.1.2 (checked 2026-11-18).
      Spring Boot 4.2.0-RC2 already ships logback 1.6.6, Jackson 3.1.8 and Jackson 2.21.8:
      remove these overrides when upgrading to Spring Boot 4.2.
        logback.version        WS-2026-0188 (DoS, fixed in 1.6.6), CVE-2026-19880 (path traversal, fixed in 1.6.3)
        jackson-bom.version    CVE-2026-110879 in tools.jackson.core:jackson-databind (fixed in 3.1.8)
        jackson-2-bom.version  CVE-2026-110879 in com.fasterxml.jackson.core:jackson-databind (fixed in 2.21.8, test scope via WireMock)
        commons-codec.version  CVE-2026-119078 (fixed in 1.23.0, test scope via Testcontainers)
    -->
    <logback.version>1.6.6</logback.version>
    <jackson-bom.version>3.1.8</jackson-bom.version>
    <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
    <commons-codec.version>1.23.0</commons-codec.version>
    <!-- Not managed by Spring Boot: CVE-2026-118042 (fixed in 33.8.0, test scope via WireMock) -->
    <guava.version>33.8.0-jre</guava.version>

    <!-- Path to contracts from services/<service>/ -->
    <contracts.dir>${project.basedir}/../../contracts</contracts.dir>

    <!-- Versions not managed by the Spring Boot BOM (checked on Maven Central on 2026-11-16) -->
    <archunit.version>1.5.1</archunit.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <wiremock-spring-boot.version>4.4.3</wiremock-spring-boot.version>
    <avro.version>1.12.2</avro.version>
    <protobuf.version>4.36.2</protobuf.version>
    <stripe-java.version>34.2.0</stripe-java.version>

    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
    <spotless-maven-plugin.version>3.11.0</spotless-maven-plugin.version>
    <protobuf-maven-plugin.version>5.1.12</protobuf-maven-plugin.version>
    <sonar-maven-plugin.version>5.9.0.7382</sonar-maven-plugin.version>

    <!--
      SonarQube Cloud. One Sonar project per service (monorepo), keyed by artifactId.
      TODO: set sonar.organization to your SonarQube Cloud organization key.
    -->
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.organization>ppossatto</sonar.organization>
    <sonar.projectKey>${sonar.organization}_${project.artifactId}</sonar.projectKey>
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml,${project.build.directory}/site/jacoco-it/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <openapi-generator-maven-plugin.version>7.27.0</openapi-generator-maven-plugin.version>
  </properties>

  <!-- ================= Versions (opt-in: a service declares it if needed) ================= -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>com.stripe</groupId>
        <artifactId>stripe-java</artifactId>
        <version>${stripe-java.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- ================= Applied to all services: test dependencies only ================= -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock.integrations</groupId>
      <artifactId>wiremock-spring-boot</artifactId>
      <version>${wiremock-spring-boot.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- ================= Plugins active in every service ================= -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <!-- dependencyConvergence often fails on Boot/WireMock transitive deps;
                     enable it when you want a stricter build. -->
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        JDK 23+ does not run annotation processors found on the classpath unless declared.
        Lombok/MapStruct are declared here; services that do not use them are unaffected.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>${lombok-mapstruct-binding.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Unit tests: *Test (surefire). Integration tests: *IT (failsafe, verify phase). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes><exclude>**/*IT.java</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>prepare-agent-integration</id>
            <goals><goal>prepare-agent-integration</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>report-integration</id>
            <phase>verify</phase>
            <goals><goal>report-integration</goal></goals>
          </execution>
          <!-- Enable once the project stabilizes:
          <execution>
            <id>check</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          -->
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>

    <!-- ================= Opt-in: a service only declares groupId/artifactId ================= -->
    <pluginManagement>
      <plugins>
        <!-- Run with: mvn verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.avro</groupId>
          <artifactId>avro-maven-plugin</artifactId>
          <version>${avro.version}</version>
          <executions>
            <execution>
              <phase>generate-sources</phase>
              <goals><goal>schema</goal></goals>
              <configuration>
                <sourceDirectory>${contracts.dir}/avro</sourceDirectory>
                <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                <stringType>String</stringType>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>io.github.ascopes</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-maven-plugin.version}</version>
          <configuration>
            <protoc>${protobuf.version}</protoc>
          </configuration>
          <executions>
            <execution>
              <goals><goal>generate</goal></goals>
              <configuration>
                <sourceDirectories>
                  <sourceDirectory>${contracts.dir}/proto</sourceDirectory>
                </sourceDirectories>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <!-- The service only sets <inputSpec> and the packages. -->
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>generate-api</id>
              <goals><goal>generate</goal></goals>
              <configuration>
                <generatorName>spring</generatorName>
                <configOptions>
                  <interfaceOnly>true</interfaceOnly>
                  <useJakartaEe>true</useJakartaEe>
                  <useTags>true</useTags>
                  <openApiNullable>false</openApiNullable>
                  <skipDefaultInterface>true</skipDefaultInterface>
                </configOptions>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>